PORT=5173

# SMTP email settings for login verification and support email delivery
# Gmail example:
SMTP_PROVIDER=gmail
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=ScanFit <yourname@gmail.com>
CONTACT_TO_EMAIL=compressbolt@gmail.com

# Cloudflare Pages Functions email login
AUTH_SECRET=
RESEND_API_KEY=
RESEND_FROM=ScanFit <login@yourdomain.com>
# Cloudflare Access / MCP portal (deployment target)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_APP_ID=
# CLOUDFLARE_ACCESS_TEAM=
# CLOUDFLARE_OAUTH_CLIENT_ID=
# CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Optional overrides
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_PODI_MODEL=gpt-realtime-1.5
OPENAI_IMAGE_MODEL=gpt-image-1.5

# PayPal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
